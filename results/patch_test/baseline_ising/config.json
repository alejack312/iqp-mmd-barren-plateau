{
  "experiment": {
    "name": "scaling_ac_smoke",
    "description": "Variance sweep for 2D Lattice with Layer-Wise init",
    "seed": 11,
    "output_dir": "results/patch_test/baseline_ising",
    "log_level": "INFO"
  },
  "circuit": {
    "family": [
      "lattice"
    ],
    "n_qubits": [
      16
    ],
    "n_generators": "n",
    "lattice": {
      "dimension": 2,
      "range": 1
    }
  },
  "kernel": {
    "type": [
      "gaussian"
    ],
    "bandwidth": [
      1.0
    ]
  },
  "init": {
    "scheme": [
      "data_dependent"
    ],
    "data_dependent": {
      "scale": 0.1
    },
    "layer_wise": {
      "scale": 0.1,
      "num_layers": 16
    },
    "data_dependent_exact": {
      "scale": 0.1
    }
  },
  "dataset": {
    "type": "ising",
    "n_samples": 128
  },
  "estimation": {
    "num_seeds": 100,
    "num_a_samples": 8,
    "num_z_samples": 32,
    "use_jax": true,
    "batch_size": 2
  },
  "anti_concentration": {
    "enabled": true,
    "max_n": 8
  }
}